# Old WordPress addresses to the replacement pages. Netlify manages domain/HTTPS redirects.
# Query rules precede path rules, so historical shortlinks keep their destination.
/  p=83                       /services/            301!
/  page_id=83                 /services/            301!
/  p=74                       /contact-us/          301!
/  page_id=74                 /contact-us/          301!
# Home shortlinks (?p=8 or ?page_id=8) already show the right page and canonical.
# Do not force a root-to-root redirect: Netlify forwards the query and it would repeat.
/cleaning-services            /services/            301
/cleaning-services/*          /services/            301
/schedule-a-house-cleaning    /contact-us/          301
/schedule-a-house-cleaning/*  /contact-us/          301
/home                         /                     301
/home/*                       /                     301
/index.php                    /                     301
/page/*                       /                     301
/sample-page                  /                     301
/sample-page/*                /                     301
/2021/*                       /                     301
/feed                         /                     301
/feed/*                       /                     301
/comments/feed/*              /                     301
/sitemap_index.xml            /sitemap-index.xml    301
/sitemap.xml                  /sitemap-index.xml    301
/wp-sitemap.xml               /sitemap-index.xml    301
/page-sitemap.xml             /sitemap-index.xml    301
/post-sitemap.xml             /sitemap-index.xml    301

# The private questionnaire never ships, even if a stale URL is requested.
/questions                    /404.html             404!
/questions/*                  /404.html             404!
